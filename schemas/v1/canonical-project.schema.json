{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outmapper.org/schemas/v1/canonical-project.schema.json",
  "title": "Outmapper canonical Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "topics",
    "keyIssues",
    "relationships",
    "knowledgeItems",
    "associations",
    "assets",
    "collections",
    "snapshots"
  ],
  "properties": {
    "manifest": { "$ref": "#/$defs/projectManifest" },
    "topics": { "type": "array", "items": { "$ref": "#/$defs/topic" } },
    "keyIssues": { "type": "array", "items": { "$ref": "#/$defs/keyIssue" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/topicRelationship" } },
    "knowledgeItems": { "type": "array", "items": { "$ref": "#/$defs/knowledgeItem" } },
    "associations": { "type": "array", "items": { "$ref": "#/$defs/knowledgeAssociation" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } },
    "theme": { "$ref": "#/$defs/theme" },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/publishedSnapshot" } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 500 },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "projectManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "formatVersion", "id", "title", "createdAt", "updatedAt", "revision"],
      "properties": {
        "format": { "const": "outmapper-project" },
        "formatVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string", "maxLength": 100000 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 0 },
        "defaultLocale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "defaultDirection": { "enum": ["auto", "ltr", "rtl"] },
        "homeTopicId": { "$ref": "#/$defs/id" },
        "themeId": { "$ref": "#/$defs/id" },
        "publishedSnapshotId": { "$ref": "#/$defs/id" },
        "contentLicense": { "type": "string", "maxLength": 500 }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string", "maxLength": 100000 },
        "visualAssetId": { "$ref": "#/$defs/id" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "keyIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topicId", "title", "order", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topicId": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "order": { "type": "integer", "minimum": 0 },
        "description": { "type": "string", "maxLength": 100000 },
        "visualAssetId": { "$ref": "#/$defs/id" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "topicRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceTopicId", "keyIssueId", "targetTopicId", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceTopicId": { "$ref": "#/$defs/id" },
        "keyIssueId": { "$ref": "#/$defs/id" },
        "targetTopicId": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0 },
        "relationType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "note": { "type": "string", "maxLength": 100000 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "knowledgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "availability", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "availability": { "enum": ["local", "external"] },
        "summary": { "type": "string", "maxLength": 100000 },
        "body": { "type": "string", "maxLength": 2000000 },
        "contentPath": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "externalUrl": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "authors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "source": { "type": "string", "maxLength": 1000 },
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
        "attachmentAssetIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "knowledgeAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "knowledgeItemId", "targetKind", "targetId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "knowledgeItemId": { "$ref": "#/$defs/id" },
        "targetKind": { "enum": ["topic", "keyIssue"] },
        "targetId": { "$ref": "#/$defs/id" },
        "pinned": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "collectionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "note": { "type": "string", "maxLength": 100000 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "originalFilename", "mimeType", "byteSize", "sha256", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "originalFilename": { "$ref": "#/$defs/nonEmptyString" },
        "mimeType": { "type": "string", "minLength": 3, "maxLength": 255 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string", "maxLength": 100000 },
        "order": { "type": "integer", "minimum": 0 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tokens"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "tokens": { "$ref": "#/$defs/metadata" },
        "brandingAssetIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "publishedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "publishedAt", "manifestPath", "assetIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "manifestPath": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "assetIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "title": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 100000 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    }
  }
}
